<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="signup"
        inherit_id="auth_signup.signup">
        <xpath expr="//t[@t-call='auth_signup.fields']"
            position="after">
            <!-- between the fields and the submit button -->
            <div id="oe_signup_country_selector">
                <img src="/frontend_js/static/src/img/expected.jpg"/>
            </div>
        </xpath>
    </template>
</odoo>